{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "additionalDirectories": [
      "../"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Edit(/runs/**)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(gh repo view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh release list *)",
      "Bash(bash *ideas*/scripts/copy_project.sh *)",
      "Bash(bash *ideas*/scripts/workspace.sh *)",
      "mcp__open-brain__search_thoughts",
      "mcp__open-brain__list_thoughts",
      "mcp__open-brain__thought_stats",
      "mcp__open-brain__list_projects",
      "mcp__open-brain__list_decisions",
      "mcp__open-brain__get_decision",
      "mcp__open-brain__search_contacts",
      "mcp__open-brain__account_brief",
      "mcp__open-brain__list_opportunities",
      "mcp__open-brain__get_opportunity",
      "mcp__open-brain__search_interactions",
      "mcp__open-brain__search_email_threads",
      "mcp__open-brain__get_email_thread"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/*credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.secret)",
      "Read(**/*.secrets)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.toml)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.git-credentials)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/supabase/.temp/**)",
      "Read(**/.vercel/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/supabase/**)",
      "Read(~/.supabase/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.local/share/com.vercel.cli/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(/runs/**/sources/**)",
      "Edit(/.claude/**)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(git push --force*)"
    ]
  }
}
